<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Restaurante">

        <activity
            android:name=".vista.ActividadListaRestaurante"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".vista.ActividadAgregarRestaurante" />
        <activity android:name=".vista.ActividadEditarRestaurante" />
        <activity android:name=".vista.ActividadListaComida" />
        <activity android:name=".vista.ActividadAgregarComida" />
        <activity android:name=".vista.ActividadEditarComida" />
        <activity android:name=".vista.ActividadDetalleComida" />

    </application>

</manifest>