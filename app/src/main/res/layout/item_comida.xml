<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/altura_item_lista"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/margen_general"
    android:paddingEnd="@dimen/margen_general"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_nombre_comida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/texto_normal"
        android:textColor="@color/negro" />

    <TextView
        android:id="@+id/tv_precio_comida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/texto_normal"
        android:textColor="@color/texto_precio" />

</LinearLayout>
